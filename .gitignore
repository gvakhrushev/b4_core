# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs — `docs/` is TRACKED (the published documentation set).
# Only the generated `forge doc` book output is ignored.
docs/book/

# Dotenv file
.env
.env.*
!.env.example

# static analysis (generated artifacts — regenerate with the commands in SLITHER.md)
.slither-venv/
slither-report.md
slither-stderr.txt
slither-failhigh.txt

# macOS
.DS_Store

# local tool state, not project configuration
.claude/

# security-scan output: a dated report directory, regenerated on demand and carrying its own
# `.gitignore`. Named here too so deleting that inner file cannot sweep a report into a commit.
CLAUDE-SECURITY-*/

# transient scratch staged for deletion (2026-07-30 reorg) — safe to remove the folder
_to_delete/
